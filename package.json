{
  "name": "tallyconnect",
  "version": "1.0.0",
  "description": "ATEM tally light for ProPresenter Stage Display / web overlays",
  "author": "SJ Tech",
  "main": "dist/main/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sj-tech-sweden/TallyConnect.git"
  },
  "scripts": {
    "dev": "tsc && electron .",
    "compile": "tsc",
    "build": "tsc && electron-builder",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\"",
    "mock": "node scripts/mock-atem-node.js",
    "mock:pyatem": "node scripts/mock-atem.js"
  },
  "build": {
    "appId": "com.sjtech.tallyconnect",
    "productName": "TallyConnect",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "src/web",
        "to": "web"
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "globals": "^15.0.0",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "atem-connection": "^3.10.3",
    "express": "^5.2.0",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "@julusian/freetype2@1.3.1": true,
    "electron@44.7.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
