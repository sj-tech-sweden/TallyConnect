{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7",
      "description": "Hold TypeScript at 6.x: typescript-eslint does not support TS 7 yet (typescript-eslint/typescript-eslint#10940). Revisit once typescript-eslint ships TS 7 support."
    },
    {
      "matchPackageNames": ["electron", "electron-builder"],
      "groupName": "electron framework",
      "automerge": false
    },
    {
      "matchDepTypes": ["devDependencies"],
      "excludePackageNames": ["electron", "electron-builder"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["atem-connection", "ws"],
      "groupName": "network & hardware protocols",
      "labels": ["hardware", "dependencies"]
    }
  ]
}